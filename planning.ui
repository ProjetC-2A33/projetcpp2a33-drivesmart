  <widget class="QCalendarWidget" name="calendarWidget">
   <property name="geometry">
    <rect>
     <x>450</x>
     <y>510</y>
     <width>500</width>
     <height>350</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">QCalendarWidget QWidget {
    background-color: white;
    color: #002157;
}

/* Navigation bar with month/year */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #4CAF50;
    color: white;
}

/* Month/Year text */
QCalendarWidget QToolButton QMenu QWidgetAction {
    background-color: white;
    color: #002157;
}

/* Prev/Next month buttons */
QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px;
    font-size: 16px;
    font-weight: bold;
    min-width: 50px;
    min-height: 30px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth:hover,
QCalendarWidget QToolButton#qt_calendar_nextmonth:hover {
    background-color: #45a049;
}

/* Month button */
QCalendarWidget QToolButton#qt_calendar_monthbutton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 5px 15px;
    font-size: 14px;
    font-weight: bold;
    min-height: 30px;
}

QCalendarWidget QToolButton#qt_calendar_monthbutton:hover {
    background-color: #45a049;
}

/* Year button */
QCalendarWidget QToolButton#qt_calendar_yearbutton {
    background-color: #4CAF50;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 5px 15px;
    font-size: 14px;
    font-weight: bold;
    min-height: 30px;
}

QCalendarWidget QToolButton#qt_calendar_yearbutton:hover {
    background-color: #45a049;
}

/* Day headers (Mon, Tue, etc) */
QCalendarWidget QWidget { 
    alternate-background-color: #f0f0f0;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #002157;
    background-color: white;
    selection-background-color: #4CAF50;
    selection-color: white;
}

/* Table view for dates */
QCalendarWidget QTableView {
    selection-background-color: #4CAF50;
    selection-color: white;
    background-color: white;
    gridline-color: #e0e0e0;
}

/* Menu dropdown */
QCalendarWidget QMenu {
    background-color: white;
    color: #002157;
}

/* SpinBox for year selection */
QCalendarWidget QSpinBox {
    background-color: white;
    color: #002157;
    selection-background-color: #4CAF50;
    selection-color: white;
}</string>
   </property>
   <property name="gridVisible">
    <bool>true</bool>
   </property>
